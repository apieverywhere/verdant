# Public address of the site, used for sitemap.xml and robots.txt (e.g. https://verdant.example).
# Leave empty to use the domain each request arrives on.
NEXT_PUBLIC_SITE_URL=

# Google Search Console → URL-prefix property → "HTML tag": the content="…" value of the meta tag it shows.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google AdSense. Copy to .env.local (or set in your host's dashboard) and rebuild: these are inlined at build time.
# Leave NEXT_PUBLIC_ADSENSE_CLIENT empty to run the site with no ads and no ad code.

# Publisher id from AdSense → Account → Account information.
NEXT_PUBLIC_ADSENSE_CLIENT=
# Ad unit id for the lobby banner (AdSense → Ads → By ad unit → Display ads).
NEXT_PUBLIC_ADSENSE_LOBBY_SLOT=
# "on" once AdSense has approved H5 Games Ads: offers an ad break when a finished round is followed by "New game".
NEXT_PUBLIC_ADSENSE_GAME_BREAKS=
# "on" to request test ads while developing (never leave on in production).
NEXT_PUBLIC_ADSENSE_TEST=
